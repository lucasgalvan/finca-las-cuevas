---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/cabanas', label: 'Cabañas' },
  { href: '/senderismo', label: 'Senderismo' },
  { href: '/dia-de-campo', label: 'Día de Campo' },
  { href: '/actividades', label: 'Actividades' },
  { href: '/contacto', label: 'Contacto' },
]

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="fixed top-0 left-0 right-0 z-40 transition-colors duration-300" id="navbar">
  <!-- Degradado de apoyo: mantiene legible el logo y los links mientras el
       header todavía es transparente sobre el hero. Baja más allá del alto
       del header para que el corte no se note, y es lo bastante denso para
       sostener el contraste incluso sobre un cielo claro. -->
  <div id="navbar-scrim" class="absolute inset-x-0 top-0 h-32 -z-10 bg-gradient-to-b from-[#181412]/92 via-[#181412]/72 to-transparent transition-opacity duration-300"></div>

  <nav class="max-w-6xl mx-auto px-6 lg:px-8" aria-label="Navegación principal">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="font-display text-2xl font-semibold text-cream tracking-wide italic">
        Finca Las Cuevas
      </a>

      <ul class="hidden lg:flex items-center gap-9">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? 'page' : undefined}
              class:list={[
                'text-[13px] font-medium uppercase tracking-[0.15em] transition-colors duration-300 pb-1',
                path === link.href
                  ? 'text-cream border-b-2 border-sand'
                  : 'text-cream/90 hover:text-cream border-b-2 border-transparent',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden relative -mr-2 w-11 h-11 flex items-center justify-center text-cream"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="absolute block w-6 h-[1.5px] bg-current transition-transform duration-300 -translate-y-[6px]" id="bar1"></span>
        <span class="absolute block w-6 h-[1.5px] bg-current transition-opacity duration-300" id="bar2"></span>
        <span class="absolute block w-6 h-[1.5px] bg-current transition-transform duration-300 translate-y-[6px]" id="bar3"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden bg-charcoal border-t border-white/10 max-h-[calc(100dvh-5rem)] overflow-y-auto">
    <ul class="flex flex-col px-6 py-4">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            aria-current={path === link.href ? 'page' : undefined}
            class:list={[
              'block py-4 text-sm uppercase tracking-[0.15em] border-b border-white/10 last:border-0 transition-colors',
              path === link.href ? 'text-sand font-semibold' : 'text-cream/90 hover:text-cream',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')!
  const scrim = document.getElementById('navbar-scrim')!
  const toggle = document.getElementById('menu-toggle')!
  const menu = document.getElementById('mobile-menu')!
  const bar1 = document.getElementById('bar1')!
  const bar2 = document.getElementById('bar2')!
  const bar3 = document.getElementById('bar3')!

  let isOpen = false

  const SOLID = 'rgba(28, 24, 22, 0.94)'

  // Siempre window.scrollY: Lenis scrollea el documento, así que este
  // valor es correcto en todos los casos. Su posición interna, en cambio,
  // se desincroniza con los scrolls programáticos (anclas, restauración
  // del navegador) y dejaba el navbar transparente sobre fondo claro.
  function updateNavbar() {
    const scrolled = window.scrollY > 60
    if (scrolled || isOpen) {
      navbar.style.backgroundColor = SOLID
      navbar.style.backdropFilter = 'blur(10px)'
      navbar.style.boxShadow = '0 1px 0 rgba(255,255,255,0.06)'
      scrim.style.opacity = '0'
    } else {
      navbar.style.backgroundColor = ''
      navbar.style.backdropFilter = ''
      navbar.style.boxShadow = ''
      scrim.style.opacity = '1'
    }
  }

  // Lenis scrollea el documento, así que el evento nativo cubre todos
  // los casos: rueda, teclado, anclas y restauración de posición.
  window.addEventListener('scroll', updateNavbar, { passive: true })
  updateNavbar()

  function setMenu(open: boolean) {
    isOpen = open
    menu.classList.toggle('hidden', !open)
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
    document.body.style.overflow = open ? 'hidden' : ''

    if (open) {
      bar1.style.transform = 'rotate(45deg)'
      bar2.style.opacity = '0'
      bar3.style.transform = 'rotate(-45deg)'
    } else {
      bar1.style.transform = ''
      bar2.style.opacity = ''
      bar3.style.transform = ''
    }
    updateNavbar()
  }

  toggle.addEventListener('click', () => setMenu(!isOpen))

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false))
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      setMenu(false)
      toggle.focus()
    }
  })

  // Al pasar a desktop, el menú mobile debe quedar cerrado y
  // el scroll del body liberado.
  const desktop = window.matchMedia('(min-width: 1024px)')
  desktop.addEventListener('change', (e) => {
    if (e.matches && isOpen) setMenu(false)
  })
</script>
