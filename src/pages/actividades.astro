---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'

const actividades = [
  {
    title: 'Kayak por el delta',
    desc: 'Recorré el delta y las islas del Paraná en kayak. Gabriel te lleva en la lancha hasta el punto de partida y te guía por un recorrido increíble entre los humedales del Sitio Ramsar.',
    image: '/img/rio-atardecer-kayak.jpg',
    alt: 'Atardecer sobre el río Paraná con un kayak en la orilla',
  },
  {
    title: 'Pesca',
    desc: 'Las Cuevas está catalogado como uno de los mejores pesqueros del Paraná medio. Dorados, surubíes, mandubíes, bogas, pejerreyes y más. Desde la costa o embarcado, según la época.',
    image: '/img/rio-reflejos.jpg',
    alt: 'Reflejos del sol sobre el agua del río Paraná',
  },
  {
    title: 'Avistaje de aves',
    desc: 'Más de 350 especies habitan la zona. En una salida de 2 horas se han registrado 62 especies diferentes. Nuestra guía no solo te las muestra, te las hace escuchar. Visitantes de Alemania, Brasil y Australia eligen este destino.',
    image: '/img/nido-vinedo.jpg',
    alt: 'Nido con pichones y huevos escondido entre las vides del viñedo',
  },
  {
    title: 'Cabalgata',
    desc: 'Recorré los alrededores de la finca a caballo. La zona está rodeada de campo, caballos y vacas. Un paisaje que te transporta a otra época.',
    image: '/img/campo-abierto.jpg',
    alt: 'Campo abierto de la finca con árboles añosos y el horizonte del delta',
  },
  {
    title: 'Safari fotográfico',
    desc: 'Explorá el monte nativo con charla previa y desayuno incluido. La fauna, los paisajes y la luz de Entre Ríos son ideales para capturar momentos únicos.',
    image: '/img/carpintero.jpg',
    alt: 'Carpintero posado sobre un poste del viñedo',
  },
]
---

<Layout title="Actividades" description="Kayak, pesca, ecoturismo, avistaje de aves, cabalgata y más en Finca Las Cuevas, portal del Sitio Ramsar Delta del Paraná.">

  <PageHero
    title="Actividades"
    subtitle="Aventura"
    description="Siempre hay algo para hacer en Finca Las Cuevas."
    image="/img/vinedo-panorama.jpg"
    imageAlt="Vista amplia del viñedo de Finca Las Cuevas bajo un cielo enorme"
  />

  <section class="bg-warm-white">
    {actividades.map((act, i) => (
      <article class={`grid grid-cols-1 lg:grid-cols-2 ${i % 2 === 0 ? 'bg-warm-white' : 'bg-cream'}`}>
        <div
          class={`aspect-[4/3] lg:aspect-auto lg:min-h-[440px] relative ${i % 2 !== 0 ? 'lg:order-2' : ''}`}
          data-parallax
        >
          <img src={act.image} alt={act.alt} loading="lazy" />
        </div>
        <div class="flex items-center px-6 lg:px-16 py-14 lg:py-20">
          <div class="max-w-lg">
            <h2 data-split-reveal class="font-display text-2xl md:text-3xl text-charcoal font-semibold italic">
              {act.title}
            </h2>
            <div class="w-12 h-px bg-wine mt-4"></div>
            <p data-reveal class="text-charcoal-light leading-relaxed mt-5">{act.desc}</p>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="bg-olive/15 py-20 md:py-24 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <span data-reveal class="inline-block text-olive text-xs uppercase tracking-[0.25em] font-semibold">Sitio Ramsar</span>
      <h2 data-split-reveal class="font-display text-2xl md:text-4xl text-charcoal font-semibold italic mt-3">
        Portal al Delta del Paraná
      </h2>
      <p data-reveal class="text-charcoal-light leading-relaxed mt-5 text-lg">
        Las Cuevas es reconocida como portal de entrada al Sitio Ramsar Delta del Paraná: 243.000 hectáreas
        de humedal de importancia internacional. Un mosaico de islas, ríos y biodiversidad entre Entre Ríos
        y Santa Fe, que incluye los parques nacionales Pre-Delta e Islas de Santa Fe.
      </p>
    </div>
  </section>

  <section class="bg-cream py-20 md:py-24 px-6 lg:px-8 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 data-split-reveal class="font-display text-3xl md:text-4xl text-charcoal font-semibold italic">
        ¿Qué actividad te gustaría hacer?
      </h2>
      <p data-reveal class="text-charcoal-light mt-4 text-lg">
        Contanos qué te interesa y te armamos la experiencia perfecta.
      </p>
      <a
        data-reveal
        href="https://wa.me/5493414022323?text=Hola!%20Quiero%20consultar%20sobre%20actividades"
        target="_blank"
        rel="noopener"
        class="inline-block mt-8 bg-wine text-cream px-9 py-4 text-sm font-semibold uppercase tracking-wider hover:bg-wine-dark transition-colors duration-300"
      >
        Consultanos
      </a>
    </div>
  </section>

</Layout>
