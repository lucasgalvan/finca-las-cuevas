---
import Layout from '../layouts/Layout.astro'

const experiencias = [
  {
    href: '/cabanas',
    img: '/img/cabana-arbol.jpg',
    alt: 'Cabaña de madera junto a un árbol añoso en Finca Las Cuevas',
    eyebrow: 'Alojamiento',
    title: 'Cabañas',
    desc: 'Cabañas de madera con pileta, quincho y parrillero. Pet Friendly.',
    span: 'md:col-span-7',
  },
  {
    href: '/senderismo',
    img: '/img/senderismo-rocas.jpg',
    alt: 'Senderistas explorando las rocas del monte nativo',
    eyebrow: 'Naturaleza',
    title: 'Senderismo',
    desc: 'Recorridos guiados por el bosque nativo, la Cueva del Tigre y el bosque energético.',
    span: 'md:col-span-5',
  },
  {
    href: '/dia-de-campo',
    img: '/img/vendimia-molienda-grupo.jpg',
    alt: 'Familia y amigos moliendo uva bajo la galería de la finca',
    eyebrow: 'Experiencia',
    title: 'Día de Campo',
    desc: 'Asado, vinos artesanales y viñedo con Gabriel.',
    span: 'md:col-span-5',
  },
  {
    href: '/actividades',
    img: '/img/rio-atardecer-kayak.jpg',
    alt: 'Atardecer sobre el río Paraná con un kayak en la orilla',
    eyebrow: 'Aventura',
    title: 'Actividades',
    desc: 'Kayak, pesca, ecoturismo, avistaje de aves y más.',
    span: 'md:col-span-7',
  },
]
---

<Layout title="Cabañas, viñedo y ecoturismo en Entre Ríos">

  <!-- ═══ HERO ═══ -->
  <section class="relative h-dvh min-h-[560px] flex items-end overflow-hidden bg-charcoal">
    <video
      id="hero-video"
      src="/hero-vendimia.mp4"
      poster="/hero-vendimia-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Vendimia en Finca Las Cuevas"
      class="absolute inset-0 w-full h-full object-cover"
    ></video>

    <!-- Scrim: garantiza contraste del texto sobre cualquier fotograma -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#181412]/90 via-[#181412]/45 to-[#181412]/35"></div>

    <div class="relative z-10 w-full px-6 lg:px-8 pb-20 md:pb-28 max-w-6xl mx-auto">
      <span data-hero-reveal="1" class="text-sand-light text-xs uppercase tracking-[0.3em] font-semibold">
        Las Cuevas, Entre Ríos
      </span>
      <h1 data-hero-reveal="2" class="font-display text-5xl md:text-7xl lg:text-8xl text-cream font-semibold italic mt-4 leading-[1.05]">
        Finca<br>Las Cuevas
      </h1>
      <p data-hero-reveal="3" class="text-cream/95 text-lg md:text-xl mt-6 max-w-xl leading-relaxed">
        Viñedo, cabañas y ecoturismo. Portal de entrada al Sitio Ramsar Delta del Paraná.
      </p>
      <div data-hero-reveal="4" class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 mt-9 max-w-md sm:max-w-none">
        <a href="/cabanas" class="bg-cream text-charcoal px-8 py-4 text-sm font-semibold uppercase tracking-wider text-center hover:bg-white transition-colors duration-300">
          Ver cabañas
        </a>
        <a
          href="https://wa.me/5493414022323?text=Hola!%20Quiero%20consultar%20sobre%20Finca%20Las%20Cuevas"
          target="_blank"
          rel="noopener"
          class="border border-cream/70 text-cream px-8 py-4 text-sm font-semibold uppercase tracking-wider text-center hover:bg-cream hover:text-charcoal transition-colors duration-300"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ INTRO ═══ -->
  <section class="bg-wine-dark py-24 md:py-32 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <span data-reveal class="inline-block text-sand text-xs uppercase tracking-[0.25em] font-semibold">Desde 2013</span>
      <h2 data-split-reveal class="font-display text-3xl md:text-5xl text-cream font-semibold italic mt-5 leading-tight">
        Un rincón donde el tiempo se detiene
      </h2>
      <p data-reveal class="text-cream/90 text-lg leading-relaxed mt-7">
        Finca Las Cuevas es mucho más que un viñedo. Es Gabriel recibiéndote con un asado, una guía nativa
        llevándote por el bosque, el silencio del delta y más de 350 especies de aves. A pasos del Parque
        Nacional Predelta, somos Pet Friendly y estamos abiertos todo el año.
      </p>
    </div>
  </section>

  <!-- ═══ EXPERIENCIAS ═══ -->
  <section class="bg-warm-white py-24 md:py-32 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl">
        <span data-reveal class="inline-block text-earth text-xs uppercase tracking-[0.25em] font-semibold">Qué te espera</span>
        <h2 data-split-reveal class="font-display text-3xl md:text-4xl text-charcoal font-semibold italic mt-3">
          Cuatro formas de vivir la finca
        </h2>
      </div>

      <!-- auto-rows fija la altura de cada fila: sin esto la tarjeta
           angosta queda más baja que la ancha y deja un hueco. -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 mt-12 md:auto-rows-[19rem] lg:auto-rows-[24rem]" data-reveal-stagger>
        {experiencias.map(exp => (
          <a href={exp.href} class={`group ${exp.span} relative aspect-[4/3] md:aspect-auto md:h-full overflow-hidden media-scrim`} data-parallax>
            <img
              src={exp.img}
              alt={exp.alt}
              class="transition-transform duration-700 group-hover:scale-[1.04]"
              loading="lazy"
            />
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 z-10">
              <span class="text-sand-light text-xs uppercase tracking-[0.2em] font-semibold">{exp.eyebrow}</span>
              <h3 class="font-display text-2xl md:text-3xl text-cream font-semibold italic mt-1">{exp.title}</h3>
              <p class="text-cream/90 text-sm mt-2 max-w-sm leading-relaxed">{exp.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FRANJA PANORÁMICA ═══ -->
  <section class="relative h-[52vh] min-h-[340px] overflow-hidden media-scrim" data-parallax>
    <img src="/img/vendimia-cielo.jpg" alt="Vendimia grupal entre las hileras del viñedo bajo un cielo amplio" loading="lazy" />
    <div class="absolute inset-0 z-10 flex items-end">
      <div class="max-w-6xl mx-auto w-full px-6 lg:px-8 pb-12 md:pb-16">
        <p data-reveal class="font-display text-2xl md:text-4xl text-cream italic font-semibold max-w-2xl leading-tight">
          En enero y febrero, la finca se llena de gente cosechando.
        </p>
        <a data-reveal href="/dia-de-campo" class="inline-block mt-6 text-cream text-sm font-semibold uppercase tracking-[0.15em] border-b-2 border-cream/60 pb-1 hover:border-cream transition-colors duration-300">
          Sumate a la vendimia
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ GABRIEL ═══ -->
  <section class="bg-charcoal text-cream">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div class="aspect-[4/3] lg:aspect-auto lg:min-h-[600px] relative" data-parallax>
        <img src="/img/gabriel-sombrero.jpg" alt="Gabriel Basaldella con su sombrero de paja y su perro entre las vides y los rosales" loading="lazy" />
      </div>
      <div class="flex items-center px-6 lg:px-16 xl:px-20 py-16 lg:py-24">
        <div class="max-w-xl">
          <span data-reveal class="inline-block text-sand text-xs uppercase tracking-[0.25em] font-semibold">Nuestra historia</span>
          <h2 data-split-reveal class="font-display text-3xl md:text-4xl text-cream font-semibold italic mt-3 leading-tight">
            Conocé a Gabriel
          </h2>
          <p data-reveal class="text-cream/90 leading-relaxed mt-6">
            Gabriel Basaldella es el alma de Finca Las Cuevas. Desde 2013 vive en la finca, te recibe
            personalmente, te cocina un asado inolvidable y te cuenta con pasión todo sobre el proceso
            artesanal de sus vinos.
          </p>
          <p data-reveal class="text-cream/90 leading-relaxed mt-4">
            Acá no hay experiencia impersonal. Cada visita es única, cada plato está hecho con dedicación,
            y cada botella de RIOMIO cuenta una historia.
          </p>
          <a data-reveal href="/dia-de-campo" class="inline-block mt-8 text-cream text-sm font-semibold uppercase tracking-[0.15em] border-b-2 border-cream/50 pb-1 hover:border-cream transition-colors duration-300">
            Viví la experiencia
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RIOMIO ═══ -->
  <section class="bg-wine-dark text-cream">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div class="flex items-center justify-end px-6 lg:px-16 xl:px-20 py-16 lg:py-24 order-2 lg:order-1">
        <div class="max-w-xl">
          <span data-reveal class="inline-block text-sand text-xs uppercase tracking-[0.25em] font-semibold">Vino RIOMIO</span>
          <h2 data-split-reveal class="font-display text-3xl md:text-4xl font-semibold italic mt-3 leading-tight">
            Vino artesanal con identidad
          </h2>
          <p data-reveal class="text-cream/90 leading-relaxed mt-6">
            Cuatro variedades de uva — Chardonnay, Marcelán, Malbec y Syrah — trabajadas de forma
            completamente artesanal. Desde la poda hasta la botella, cada paso es manual.
          </p>
          <p data-reveal class="text-cream/90 leading-relaxed mt-4">
            En enero y febrero podés participar de la vendimia y vivir de cerca todo el proceso. También
            elaboramos espumante artesanal que solo se puede disfrutar en la finca.
          </p>

          <dl data-reveal-stagger class="flex flex-wrap gap-10 mt-10">
            <div>
              <dd class="font-display text-4xl italic text-sand">4</dd>
              <dt class="text-cream/70 text-xs uppercase tracking-wider mt-1">Variedades</dt>
            </div>
            <div>
              <dd class="font-display text-4xl italic text-sand">{new Date().getFullYear() - 2013}</dd>
              <dt class="text-cream/70 text-xs uppercase tracking-wider mt-1">Años</dt>
            </div>
            <div>
              <dd class="font-display text-4xl italic text-sand">100%</dd>
              <dt class="text-cream/70 text-xs uppercase tracking-wider mt-1">Manual</dt>
            </div>
          </dl>
        </div>
      </div>
      <div class="aspect-[4/3] lg:aspect-auto lg:min-h-[600px] relative order-1 lg:order-2" data-parallax>
        <img src="/img/racimo-cielo.jpg" alt="Mano sosteniendo un racimo de uva tinta contra el cielo azul" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ═══ CTA FINAL ═══ -->
  <section class="bg-cream py-24 md:py-32 px-6 lg:px-8 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 data-split-reveal class="font-display text-3xl md:text-5xl text-charcoal font-semibold italic leading-tight">
        ¿Te gustaría visitarnos?
      </h2>
      <p data-reveal class="text-charcoal-light text-lg mt-5 leading-relaxed">
        Consultanos disponibilidad de cabañas, coordiná tu día de campo, o simplemente vení a disfrutar
        del viñedo. Estamos abiertos todo el año.
      </p>
      <a
        data-reveal
        href="https://wa.me/5493414022323?text=Hola!%20Quiero%20consultar%20sobre%20Finca%20Las%20Cuevas"
        target="_blank"
        rel="noopener"
        class="inline-block mt-9 bg-wine text-cream px-9 py-4 text-sm font-semibold uppercase tracking-wider hover:bg-wine-dark transition-colors duration-300"
      >
        Escribinos por WhatsApp
      </a>
    </div>
  </section>

</Layout>
