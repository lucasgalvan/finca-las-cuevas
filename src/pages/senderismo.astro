---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'

const puntos = [
  { title: 'Cueva del Tigre', desc: 'Formación natural icónica. Un lugar de leyendas e historias que parece otro mundo.' },
  { title: 'Bosque energético', desc: 'Un espacio de 3x3m donde las brújulas dejan de funcionar. Visitado por grupos de yoga y meditación.' },
  { title: 'Flora y fauna nativa', desc: 'Espinillos, ombúes centenarios, azucenas. Reconocimiento de plantas medicinales y avistaje de aves.' },
  { title: 'Vertientes y cascada', desc: 'Vertientes naturales de agua potable, arroyos que nacen en el monte y rincones escondidos.' },
]

const nocturno = [
  'Recorrido guiado por el viñedo + degustación',
  'Parada consciente en el Bosque Energético',
  'Visita a la Cueva del Tigre bajo las estrellas',
  'Observación astronómica',
  'Activación de los cinco sentidos',
  'Cierre con choripanes y charla',
]
---

<Layout title="Senderismo" description="Trekking guiado por el bosque nativo de Finca Las Cuevas. Cueva del Tigre, bosque energético, avistaje de aves y trekking nocturno.">

  <PageHero
    title="Senderismo"
    subtitle="Naturaleza"
    description="Recorridos guiados por el bosque nativo con nuestra guía experta en flora y fauna de la región."
    image="/img/monte-flores.jpg"
    imageAlt="Copas de los árboles del monte en flor contra el cielo azul"
  />

  <section class="bg-warm-white py-24 md:py-32 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-start">

      <div>
        <span data-reveal class="inline-block text-earth text-xs uppercase tracking-[0.25em] font-semibold">El recorrido</span>
        <h2 data-split-reveal class="font-display text-3xl md:text-4xl text-charcoal font-semibold italic mt-3 leading-tight">
          Descubrí el bosque nativo
        </h2>
        <p data-reveal class="text-charcoal-light leading-relaxed mt-6">
          Nuestra guía nativa te lleva por senderos a través del monte, donde nacen vertientes naturales de
          agua potable y pequeños arroyos. Un recorrido accesible para cualquier persona, donde vas a
          cruzarte con más de 350 especies de aves, ciervos, guazunchos y una flora autóctona increíble.
        </p>

        <div class="mt-10 space-y-6" data-reveal-stagger>
          {puntos.map(item => (
            <div class="border-l-2 border-olive pl-5">
              <h3 class="font-display text-lg text-charcoal font-semibold italic">{item.title}</h3>
              <p class="text-charcoal-light text-sm mt-1 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="space-y-4">
        <div class="aspect-[3/4] relative" data-parallax>
          <img src="/img/arbol-cintas.jpg" alt="Árbol añoso de tronco retorcido con cintas de colores en el parque de la finca" loading="lazy" />
        </div>
        <div class="grid grid-cols-2 gap-4" data-reveal-stagger>
          <div class="bg-cream border border-sand/50 p-5 text-center">
            <span class="font-display text-2xl italic text-wine">2-3 hs</span>
            <p class="text-charcoal-light text-xs uppercase tracking-wider mt-1">Duración</p>
          </div>
          <div class="bg-cream border border-sand/50 p-5 text-center">
            <span class="font-display text-2xl italic text-wine">Fácil</span>
            <p class="text-charcoal-light text-xs uppercase tracking-wider mt-1">Dificultad</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="bg-charcoal text-cream">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div class="aspect-[4/3] lg:aspect-auto lg:min-h-[600px] relative" data-parallax>
        <img src="/img/atardecer-vinedo.jpg" alt="Siluetas cosechando en el viñedo al atardecer bajo un cielo dramático" loading="lazy" />
      </div>
      <div class="flex items-center px-6 lg:px-16 xl:px-20 py-16 lg:py-24">
        <div class="max-w-xl">
          <span data-reveal class="inline-block text-sand text-xs uppercase tracking-[0.25em] font-semibold">Nuevo</span>
          <h2 data-split-reveal class="font-display text-3xl md:text-4xl font-semibold italic mt-3 leading-tight">
            Trekking Nocturno Sensorial
          </h2>
          <p data-reveal class="text-cream/90 leading-relaxed mt-6">
            Cuando cae el sol, el camino cambia. Los sonidos se intensifican. Las sombras cobran forma.
            Las leyendas despiertan.
          </p>
          <ul data-reveal class="mt-7 space-y-3 text-cream/85 text-sm">
            {nocturno.map(item => (
              <li class="flex gap-3">
                <span class="text-sand mt-[7px] w-1.5 h-1.5 rounded-full bg-sand shrink-0" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            data-reveal
            href="https://wa.me/5493414022323?text=Hola!%20Quiero%20consultar%20sobre%20el%20trekking%20nocturno"
            target="_blank"
            rel="noopener"
            class="inline-block mt-9 border border-cream/70 text-cream px-8 py-4 text-sm font-semibold uppercase tracking-wider hover:bg-cream hover:text-charcoal transition-colors duration-300"
          >
            Consultar fechas
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-20 md:py-24 px-6 lg:px-8 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 data-split-reveal class="font-display text-3xl md:text-4xl text-charcoal font-semibold italic">
        ¿Querés hacer el recorrido?
      </h2>
      <p data-reveal class="text-charcoal-light mt-4 text-lg">
        Coordiná tu visita y viví la experiencia del bosque nativo.
      </p>
      <a
        data-reveal
        href="https://wa.me/5493414022323?text=Hola!%20Quiero%20consultar%20sobre%20el%20senderismo"
        target="_blank"
        rel="noopener"
        class="inline-block mt-8 bg-wine text-cream px-9 py-4 text-sm font-semibold uppercase tracking-wider hover:bg-wine-dark transition-colors duration-300"
      >
        Consultar
      </a>
    </div>
  </section>

</Layout>
